# TenderAI Sentinel Configuration

# LLM Provider selection: "mock", "gigachat", "yandexgpt"
LLM_PROVIDER=mock

# Sber GigaChat API credentials
# Get key from: https://developers.sber.ru/portal/products/gigachat-api
GIGACHAT_CREDENTIALS=your_gigachat_auth_key_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=false

# Yandex Cloud YandexGPT credentials
# Get keys from: https://cloud.yandex.ru/docs/foundation-models/
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
YANDEX_MODEL_URI=gpt://your_folder_id/yandexgpt/latest

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Application Settings
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
